<!DOCTYPE html>
<html lang="pt-PT">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Carrinho — Terra & Fogo</title>
<link rel="stylesheet" href="css/style.css">
</head>
<body>

<header class="site-header">
  <div class="wrap">
    <a href="index.html" class="logo"><span class="ring"></span> Terra &amp; Fogo</a>
    <nav class="main-nav">
      <a href="loja.html">Loja</a>
      <a href="workshops.html">Workshops</a>
      <a href="videos.html">Vídeos</a>
      <a href="noticias.html">Anúncios</a>
      <a href="contacto.html">Contacto</a>
    </nav>
    <div class="header-actions">
      <a href="carrinho.html" class="cart-link active">Carrinho <span data-cart-count style="display:none">0</span></a>
      <button class="menu-toggle" aria-label="Abrir menu">☰</button>
    </div>
  </div>
</header>

<section>
  <div class="wrap">
    <span class="eyebrow">O seu carrinho</span>
    <h1 style="font-size:clamp(30px,3.6vw,44px); margin:12px 0 36px;">Carrinho</h1>
    <div id="cart-content"></div>
  </div>
</section>

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-bottom">
      <span>© <span data-year></span> Terra &amp; Fogo</span>
      <span>Envio em 3–5 dias úteis, embalagem reforçada para cerâmica.</span>
    </div>
  </div>
</footer>

<script src="js/products.js"></script>
<script src="js/cart.js"></script>
<script src="js/main.js"></script>
<script>
(async function () {
  await loadProducts();
  function render() {
    const lines = cartLines();
    const el = document.getElementById("cart-content");
    if (lines.length === 0) {
      el.innerHTML = `
        <div style="text-align:center; padding:50px 0;">
          <p class="lede" style="margin:0 auto 24px;">O carrinho está vazio.</p>
          <a href="loja.html" class="btn btn-primary">Ver peças</a>
        </div>`;
      return;
    }
    el.innerHTML = `
      <div style="display:flex; flex-direction:column; gap:0; border-top:1px solid var(--linha);">
        ${lines.map(l => `
          <div style="display:flex; gap:20px; align-items:center; padding:22px 0; border-bottom:1px solid var(--linha);">
            <div style="width:88px; height:110px; background:var(--tenmoku-3); border-radius:3px; overflow:hidden; flex-shrink:0;">
              <img src="${l.product.img}" alt="${l.product.nome}" style="width:100%; height:100%; object-fit:cover;">
            </div>
            <div style="flex:1;">
              <a href="produto.html?id=${l.product.id}"><h3 class="card-title" style="font-size:18px;">${l.product.nome}</h3></a>
              <span class="spec-line" style="border:none; padding:0; margin:4px 0 0;"><span>${l.product.vidrado}</span></span>
            </div>
            <div style="display:flex; align-items:center; gap:8px;">
              <button class="btn btn-outline" style="padding:8px 12px;" onclick="setQty('${l.id}', ${l.qty - 1}); render();">–</button>
              <span style="font-family:var(--mono); min-width:20px; text-align:center;">${l.qty}</span>
              <button class="btn btn-outline" style="padding:8px 12px;" onclick="setQty('${l.id}', ${l.qty + 1}); render();">+</button>
            </div>
            <div class="price" style="min-width:90px; text-align:right;">${formatEUR(l.product.preco * l.qty)}</div>
            <button onclick="removeFromCart('${l.id}'); render();" aria-label="Remover" style="background:none; border:none; color:var(--biscuit-dim); font-size:18px;">✕</button>
          </div>
        `).join("")}
      </div>
      <div style="display:flex; justify-content:flex-end; margin-top:30px;">
        <div style="width:100%; max-width:320px;">
          <div style="display:flex; justify-content:space-between; font-family:var(--mono); color:var(--biscuit-dim); margin-bottom:10px;">
            <span>Subtotal</span><span>${formatEUR(cartTotal())}</span>
          </div>
          <div style="display:flex; justify-content:space-between; font-family:var(--mono); color:var(--biscuit-dim); margin-bottom:20px;">
            <span>Envio</span><span>Calculado no checkout</span>
          </div>
          <a href="checkout.html" class="btn btn-primary btn-block">Finalizar compra</a>
        </div>
      </div>`;
  }
  render();
})();
</script>
</body>
</html>
